{
  "name": "university-dental-clinic",
  "version": "1.0.0",
  "description": "University Dental Clinic Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n backend,browser \"nodemon --watch server.js --watch backend --ext js,json server.js\" \"browser-sync start --config bs-config.cjs\"",
